APP_NAME="Portal CGNAT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_MAINTENANCE_STORE=file
QUEUE_FAILED_DRIVER=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=portal-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CLICKHOUSE_ENABLED=false
CLICKHOUSE_TIMEZONE=America/Lima
CLICKHOUSE_CONNECT_TIMEOUT=3
CLICKHOUSE_QUERY_TIMEOUT=30
CLICKHOUSE_MAX_INTERACTIVE_HOURS=24
CLICKHOUSE_PAGE_SIZE=100
CLICKHOUSE_NODES=ch01,ch02,ch03,ch04

CLICKHOUSE_CH01_LABEL=CH-01
CLICKHOUSE_CH01_URL=http://ch01.internal:8123
CLICKHOUSE_CH01_USERNAME=portal_cgnat
CLICKHOUSE_CH01_PASSWORD=
CLICKHOUSE_CH01_DATABASE=cgnat
CLICKHOUSE_CH01_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH01_VERIFY_TLS=false

CLICKHOUSE_CH02_LABEL=CH-02
CLICKHOUSE_CH02_URL=http://ch02.internal:8123
CLICKHOUSE_CH02_USERNAME=portal_cgnat
CLICKHOUSE_CH02_PASSWORD=
CLICKHOUSE_CH02_DATABASE=cgnat
CLICKHOUSE_CH02_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH02_VERIFY_TLS=false

CLICKHOUSE_CH03_LABEL=CH-03
CLICKHOUSE_CH03_URL=http://ch03.internal:8123
CLICKHOUSE_CH03_USERNAME=portal_cgnat
CLICKHOUSE_CH03_PASSWORD=
CLICKHOUSE_CH03_DATABASE=cgnat
CLICKHOUSE_CH03_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH03_VERIFY_TLS=false

CLICKHOUSE_CH04_LABEL=CH-04
CLICKHOUSE_CH04_URL=http://ch04.internal:8123
CLICKHOUSE_CH04_USERNAME=portal_cgnat
CLICKHOUSE_CH04_PASSWORD=
CLICKHOUSE_CH04_DATABASE=cgnat
CLICKHOUSE_CH04_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH04_VERIFY_TLS=false

PORTAL_STORE_NODE=ch04
PORTAL_STORE_DATABASE=portal_cgnat
PORTAL_STORE_CONNECT_TIMEOUT=3
PORTAL_STORE_QUERY_TIMEOUT=10

CAS_URL_AUTH=https://cas.internal
CAS_API_KEY=
CAS_APP_SECRET=
CAS_REDIRECT_TO=http://localhost:8080/consultas
CAS_VERIFY_TLS=true
CAS_TIMEOUT=10
# OPENSSL_CONF=/var/www/html/deploy/openssl/cas-legacy.cnf
