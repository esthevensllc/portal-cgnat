# syntax=docker/dockerfile:1.7

ARG PHP_VERSION=8.5.9
ARG COMPOSER_VERSION=2.10.2
ARG NODE_VERSION=24.18.0

FROM php:${PHP_VERSION}-fpm-bookworm AS php-base

ARG PHPREDIS_VERSION=6.3.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libicu-dev \
        libldap2-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-configure ldap --with-libdir="lib/$(uname -m)-linux-gnu" \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        ldap \
        intl \
        pcntl \
        zip \
    && pecl install "redis-${PHPREDIS_VERSION}" \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY containers/app/php.ini /usr/local/etc/php/conf.d/99-portal.ini
COPY containers/app/fpm-status.conf /usr/local/etc/php-fpm.d/99-portal-status.conf
COPY --chmod=0755 containers/app/entrypoint.sh /usr/local/bin/portal-entrypoint

WORKDIR /var/www/html
ENTRYPOINT ["portal-entrypoint"]

FROM composer:${COMPOSER_VERSION} AS composer-bin

FROM php-base AS development

COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer

CMD ["php-fpm"]

FROM development AS test

COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache composer install \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --no-scripts
COPY . /var/www/html
RUN touch .env \
    && composer dump-autoload --optimize

CMD ["php", "artisan", "test"]

FROM composer-bin AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY routes ./routes
COPY artisan ./artisan
RUN composer dump-autoload --no-dev --optimize

FROM node:${NODE_VERSION}-bookworm-slim AS assets

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY resources ./resources
COPY vite.config.js ./vite.config.js
RUN npm run build

FROM php-base AS production

COPY --chown=www-data:www-data . /var/www/html
COPY --chown=www-data:www-data --from=vendor /app/vendor /var/www/html/vendor
COPY --chown=www-data:www-data --from=vendor /app/bootstrap/cache /var/www/html/bootstrap/cache
COPY --chown=www-data:www-data --from=assets /app/public/build /var/www/html/public/build

RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

CMD ["php-fpm"]
