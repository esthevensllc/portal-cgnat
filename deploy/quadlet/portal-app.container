[Unit]
Description=Aplicación PHP-FPM del Portal CGNAT
Requires=portal-redis.service
After=portal-redis.service

[Container]
ContainerName=portal-app
Image=localhost/portal-cgnat/runtime:0.1.7
Network=portal-cgnat.network
DNS=10.89.0.1
EnvironmentFile=/index2/portal-cgnat/config/portal.env
Volume=/index2/portal-cgnat/current:/var/www/html:ro,Z
Volume=/index2/portal-cgnat/current/containers/app/php.ini:/usr/local/etc/php/conf.d/99-portal.ini:ro,Z
Volume=/index2/portal-cgnat/current/containers/app/fpm-status.conf:/usr/local/etc/php-fpm.d/99-portal-status.conf:ro,Z
Volume=/index2/portal-cgnat/shared/storage:/var/www/html/storage:Z
Volume=/index2/portal-cgnat/exports:/var/www/html/storage/app/exports:Z
Volume=/index2/portal-cgnat/shared/bootstrap-cache:/var/www/html/bootstrap/cache:Z
HealthCmd=php-fpm -t
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
