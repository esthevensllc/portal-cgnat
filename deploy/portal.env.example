APP_NAME="Portal CGNAT"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://SERVER_INTERNAL_IP:8080
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stderr
LOG_LEVEL=info

APP_MAINTENANCE_STORE=file
QUEUE_FAILED_DRIVER=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=portal-redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CLICKHOUSE_ENABLED=false
CLICKHOUSE_TIMEZONE=America/Lima
CLICKHOUSE_CONNECT_TIMEOUT=3
CLICKHOUSE_QUERY_TIMEOUT=30
CLICKHOUSE_EXPORT_TIMEOUT=3600
CLICKHOUSE_MAX_INTERACTIVE_HOURS=168
CLICKHOUSE_PAGE_SIZE=100
CLICKHOUSE_EXPORT_THRESHOLD=500000
CLICKHOUSE_NODES=ch01,ch02,ch03,ch04

CLICKHOUSE_CH01_LABEL=CH-01
CLICKHOUSE_CH01_URL=http://CH01_INTERNAL_IP:8123
CLICKHOUSE_CH01_USERNAME=portal_cgnat
CLICKHOUSE_CH01_PASSWORD=CHANGE_ME
CLICKHOUSE_CH01_DATABASE=cgnat
CLICKHOUSE_CH01_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH01_VERIFY_TLS=false

CLICKHOUSE_CH02_LABEL=CH-02
CLICKHOUSE_CH02_URL=http://CH02_INTERNAL_IP:8123
CLICKHOUSE_CH02_USERNAME=portal_cgnat
CLICKHOUSE_CH02_PASSWORD=CHANGE_ME
CLICKHOUSE_CH02_DATABASE=cgnat
CLICKHOUSE_CH02_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH02_VERIFY_TLS=false

CLICKHOUSE_CH03_LABEL=CH-03
CLICKHOUSE_CH03_URL=http://CH03_INTERNAL_IP:8123
CLICKHOUSE_CH03_USERNAME=portal_cgnat
CLICKHOUSE_CH03_PASSWORD=CHANGE_ME
CLICKHOUSE_CH03_DATABASE=cgnat
CLICKHOUSE_CH03_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH03_VERIFY_TLS=false

CLICKHOUSE_CH04_LABEL=CH-04
CLICKHOUSE_CH04_URL=http://CH04_INTERNAL_IP:8123
CLICKHOUSE_CH04_USERNAME=portal_cgnat
CLICKHOUSE_CH04_PASSWORD=CHANGE_ME
CLICKHOUSE_CH04_DATABASE=cgnat
CLICKHOUSE_CH04_TABLE_PATTERN=huawei_cgn_nat_v2_%s
CLICKHOUSE_CH04_VERIFY_TLS=false

# ClickHouse que guarda usuarios, roles, permisos y auditoría del portal.
PORTAL_STORE_URL=
PORTAL_STORE_USERNAME=
PORTAL_STORE_PASSWORD=
PORTAL_STORE_DATABASE=portal_cgnat
PORTAL_STORE_VERIFY_TLS=false
PORTAL_STORE_CONNECT_TIMEOUT=3
PORTAL_STORE_QUERY_TIMEOUT=10

# Autenticación corporativa LDAP
PORTAL_AUTH_ENABLED=true
PORTAL_AUTH_TEMPORARY_USERNAME=acceso_temporal
LDAP_HOST=LDAP_INTERNAL_IP
LDAP_PORT=389
LDAP_BASE_DN="DC=example,DC=local"
LDAP_DOMAIN=TIM
# LDAP_ALLOWED_GROUP="CN=Grupo autorizado,OU=Grupos,DC=example,DC=local"
LDAP_TIMEOUT=10
LDAP_LOGIN_MAX_ATTEMPTS=5
LDAP_LOGIN_DECAY_SECONDS=300
